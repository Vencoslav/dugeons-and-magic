[sub_resource type="GDScript" id="GDScript_mfdv2"]
script/source = "extends Node2D

@onready var path_follow = %PathFollow2D
@onready var timer = $GlobalTimer
@onready var healthTimer = $IncreseDifficultyTimer
@onready var level_menu = $LevelUpMenu
@onready var auto_shoot_timer = $AutoShootTimer
@onready var upgrade_container = $LevelUpMenu/ColorRect/VBoxContainer

@onready var auto_label = get_tree().current_scene.get_node(\"player/AutoShootLabel\")
@onready var staff = get_tree().current_scene.get_node(\"player/staff\")
@onready var magnet = get_tree().current_scene.get_node(\"player/Magnet/CollisionShape2D\")
@onready var healigTimer = get_tree().current_scene.get_node(\"player/TextureHealhBar/HealingTimer\")

var fade_tween: Tween

var player
var kills_panel
var healthBar

var fireball_speed_bonus := 1.0
var slimeHealthBonus := 0
var slimeSpeedBonus := 0
var slimeDamageBonus := 0

var maxSlimes := 5
var currentSlimes := 0
var kills := 0
var is_paused := false
var reroll_used := false

func _ready():
	player = get_tree().current_scene.get_node(\"player\")
	auto_label = player.get_node(\"AutoShootLabel\")
	staff = player.get_node(\"staff\")
	staff.auto_shoot_changed.connect(update_auto_shoot_label)
	update_auto_shoot_label(staff.auto_shoot)

	healthBar = player.get_node(\"TextureHealhBar\")
	kills_panel = player.get_node(\"KillsPanel\")
	kills_panel.set_kills(0)

	player.add_to_group(\"player\")
	player.level_up.connect(_on_player_level_up)

func _process(_delta): 
	if Input.is_action_just_pressed(\"pause_menu\"): 
		is_paused = true 
		get_tree().paused = true 
		$PauseMenu.visible = true

func spawn_mob():
	if currentSlimes >= maxSlimes:
		return
	
	var mob = preload(\"res://slime.tscn\").instantiate()
	path_follow.progress_ratio = randf()
	mob.global_position = path_follow.global_position
	
	mob.health += slimeHealthBonus
	mob.speed += slimeSpeedBonus
	mob.damage += slimeDamageBonus
	
	add_child(mob)
	currentSlimes += 1
	
	# Po zničení slima se počet sníží
	mob.tree_exited.connect(_on_slime_removed)

func _on_slime_removed():
	kills += 1
	currentSlimes -= 1
	kills_panel.set_kills(kills)

func _on_global_timer_timeout() -> void:
	spawn_mob()	

func _on_player_health_depleted() -> void:
	show_game_over()

func _on_button_try_again_pressed() -> void:
	Input.flush_buffered_events()
	get_tree().paused = false
	get_tree().reload_current_scene()

func _on_increse_difficulty_timer_timeout() -> void:
	slimeHealthBonus += 5
	slimeSpeedBonus += 5
	maxSlimes += 2
	slimeDamageBonus += 5
	player.pending_xp_bonus += 20

func _on_button_quit_game_pressed() -> void:
	Input.flush_buffered_events() 
	get_tree().quit()

func _on_button_restart_pressed() -> void:
	Input.flush_buffered_events()
	get_tree().paused = false
	get_tree().reload_current_scene()

func _on_button_resume_pressed() -> void:
	Input.flush_buffered_events()
	is_paused = false
	get_tree().paused = false
	$PauseMenu.visible = false

func show_game_over():
	%GameOver.visible = true
	get_tree().paused = true

	var status = %GameOver/ColorRect
	var slime_label = status.get_node(\"SlimeKills\")
	var time_label = status.get_node(\"DeadTime\")
	var level_label = status.get_node(\"DosazeniLevel\")

	slime_label.text = \"Slimes killed: \" + str(kills)
	
	level_label.text = \"Level reached: \" + str(player.level)

	if player.has_node(\"Time/Panel\"):
		var time_panel = player.get_node(\"Time/Panel\")
		time_label.text = \"Time survived: \" + time_panel.get_time_formatted()
	else:
		time_label.text = \"Time survived: 00:00\"

func show_next_level_up():
	if player.pending_level_ups <= 0:
		return

	player.pending_level_ups -= 1
	level_menu.visible = true
	get_tree().paused = true
	
	reroll_used = false
	$LevelUpMenu/ColorRect/ButtonReroll.visible = true

	show_random_upgrades()

func close_level_up_menu():
	level_menu.visible = false
	get_tree().paused = false

	if player.pending_level_ups > 0:
		show_next_level_up()

func _on_player_level_up() -> void:
	if player.pending_level_ups > 0 and not level_menu.visible:
		show_next_level_up()
		
		
func show_random_upgrades():
	var upgrades = upgrade_container.get_children()

	for u in upgrades:
		u.visible = false

	upgrades.shuffle()

	for i in range(min(3, upgrades.size())):
		var upgrade_node = upgrades[i]
		upgrade_node.visible = true
		upgrade_container.move_child(upgrade_node, i)


func _on_button_health_pressed() -> void:
	player.increase_max_health(player.max_health * 0.1)
	if healthBar:
		var base_width := 200.0
		var scale_factor := 2.0
		var new_width: float = base_width + player.max_health * scale_factor

		var tween = create_tween()
		tween.tween_property(healthBar, \"size:x\", new_width, 0.5)

	close_level_up_menu()

func _on_button_speed_pressed() -> void:
	player.movementSpeed *= 1.1 
	close_level_up_menu()

func _on_button_damage_pressed() -> void:
	player.damage *= 1.2
	close_level_up_menu()

func _on_button_fire_rate_pressed() -> void:
	var staff = player.get_node(\"staff\")
	staff.increase_fire_rate() 
	close_level_up_menu()

func _on_button_bullet_speed_pressed() -> void:
	fireball_speed_bonus *= 1.1
	close_level_up_menu()
	
func _on_button_magnet_size_pressed() -> void:
	var shape = magnet.shape
	magnet.shape.radius *= 1.1
	close_level_up_menu()

func _on_button_healing_pressed() -> void:
	player.healing += 0.25
	close_level_up_menu()
	
func _on_button_crit_rate_pressed() -> void:
	player.crit_rate += 0.025
	player.crit_rate = clamp(player.crit_rate, 0, 1)
	close_level_up_menu()


func _on_button_crit_damage_pressed() -> void:
	player.crit_damage += 0.05
	close_level_up_menu()
	
func _on_button_reroll_pressed() -> void:
	if reroll_used:
		return
	
	reroll_used = true
	show_random_upgrades()
	$LevelUpMenu/ColorRect/ButtonReroll.visible = false

func update_auto_shoot_label(enabled: bool):
	var auto_label = player.get_node(\"AutoShootLabel\")
	if fade_tween and fade_tween.is_running():
		fade_tween.kill()
		
	auto_shoot_timer.stop()

	auto_label.visible = true
	auto_label.text = \"AUTO SHOOT: ON\" if enabled else \"AUTO SHOOT: OFF\"
	auto_label.modulate = Color.GREEN if enabled else Color.RED
	auto_label.modulate.a = 1.0

	auto_shoot_timer.start()

func _on_auto_shoot_timer_timeout() -> void:
	var auto_label = player.get_node(\"AutoShootLabel\")
	fade_tween = create_tween()
	fade_tween.tween_property(auto_label, \"modulate:a\", 0.0, 0.25)
	fade_tween.tween_callback(func(): auto_label.visible = false)  
"

